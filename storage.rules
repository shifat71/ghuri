rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Guide post uploads: only authenticated guides can upload to their own folder
    match /guide_posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024; // 50MB limit
    }

    // Guide profile images (avatar, cover, portfolio)
    match /guide_profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    // Verification documents (Student ID, NID uploads)
    // Users can upload to their own folder, only admins can read others'
    match /verification/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || true);
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }
  }
}
